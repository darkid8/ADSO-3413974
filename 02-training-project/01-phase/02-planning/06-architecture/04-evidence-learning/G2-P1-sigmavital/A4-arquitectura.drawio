        <mxCell id="l1" value="&lt;b&gt;Capa 1 · Presentación (SPA Web Responsiva)&lt;/b&gt;&lt;br&gt;React 18 + Vite + TypeScript (Desktop / Tableta)&lt;br&gt;Vistas por rol: Coordinador, Paramédico, Administrador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="680" height="95" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;Capa 2 · Controladores, Seguridad API y Tiempo Real&lt;/b&gt;&lt;br&gt;API REST Express + Controladores HTTP | Middleware JWT + RBAC + Validación OWASP&lt;br&gt;Gateway WebSockets (Socket.IO) bajo HTTPS/WSS (TLS 1.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="210" width="680" height="95" as="geometry"/></mxCell>
        <mxCell id="l3" value="&lt;b&gt;Capa 3 · Lógica de Negocio y Patrones&lt;/b&gt;&lt;br&gt;ServicioDespacho (Strategy TAB/TAM) | ServicioFlotaREPS | ServicioAtencionAPH&lt;br&gt;Publicador de Eventos (Observer: MonitorTiempoReal + AuditoriaInmutable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="360" width="680" height="95" as="geometry"/></mxCell>
        <mxCell id="l4" value="&lt;b&gt;Capa 4 · Persistencia y Datos Relacionales&lt;/b&gt;&lt;br&gt;Repositorios desacoplados + Pool de conexiones pg (consultas parametrizadas)&lt;br&gt;PostgreSQL 16 (Tablas núcleo + Log de auditoría append-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="510" width="680" height="95" as="geometry"/></mxCell>
